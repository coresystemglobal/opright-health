{
  "name": "hospital-management",
  "version": "1.0.0",
  "description": "Hospital/health facility management application",
  "keywords": [
    "hospital",
    "management"
  ],
  "homepage": "https://github.com/stevesdiary/hospital-management#readme",
  "bugs": {
    "url": "https://github.com/stevesdiary/hospital-management/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevesdiary/hospital-management.git"
  },
  "license": "Apache-2.0",
  "author": "Stephen Oyeyemi",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "dev": "nodemon --exec ts-node src/main.ts",
    "build": "tsc && tsc-alias",
    "start": "tsc && tsc-alias && node dist/main.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:test": "NODE_ENV=test sequelize-cli db:migrate",
    "seed": "sequelize-cli db:seed:all",
    "seed:test": "NODE_ENV=test sequelize-cli db:seed:all",
    "db:create:test": "NODE_ENV=test sequelize-cli db:create",
    "db:drop:test": "NODE_ENV=test sequelize-cli db:drop",
    "verify:policy": "ts-node -r tsconfig-paths/register src/scripts/verify-policy.ts",
    "verify:policy:strict": "ts-node -r tsconfig-paths/register src/scripts/verify-policy.ts --strict"
  },
  "dependencies": {
    "@types/aws-sdk": "^0.0.42",
    "@types/axios": "^0.9.36",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "amqplib": "^0.10.3",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "express-xss-sanitizer": "^2.0.1",
    "firebase-admin": "^14.1.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.7.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.7",
    "otplib": "^13.4.1",
    "path-to-regexp": "^8.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "redis": "^4.6.10",
    "sequelize": "^6.37.3",
    "sequelize-typescript": "^2.1.6",
    "socket.io": "^4.8.1",
    "stripe": "^14.25.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@types/amqplib": "^0.10.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.8.7",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.6",
    "@types/stripe": "^8.0.417",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "sequelize-cli": "^6.6.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
